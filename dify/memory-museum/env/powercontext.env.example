# Copy to a private file outside source control and replace the token.
POWERCONTEXT_HOME=/absolute/path/to/powercontext-data
POWERCONTEXT_SERVER_HTTP_HOST=127.0.0.1
POWERCONTEXT_SERVER_HTTP_PORT=8000
POWERCONTEXT_SERVER_AUTH_ENABLED=true
POWERCONTEXT_SERVER_AUTH_TOKEN=replace-with-a-long-random-token
POWERCONTEXT_SERVER_DATABASE_KIND=sqlite
