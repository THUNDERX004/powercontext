# Replace every placeholder before running in a new environment.
# New defaults for this Qoder submission live under qoder/.
SDDCTX_PROJECT_KEY=qoder-sdd

# seekdb or OceanBase over the MySQL protocol.
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=replace-me
SEEKDB_DATABASE=qoder_sdd

# PowerContext Server.
SDDCTX_POWERCONTEXT_URL=http://127.0.0.1:8000
# SDDCTX_POWERCONTEXT_TOKEN=

# MiniMax is the optional runtime code model, used only by `sddctx dev`.
# Context building, verification, and scripts/run_context_demo.py need no key.
SDDCTX_MINIMAX_API_KEY=replace-me
SDDCTX_MINIMAX_BASE_URL=https://api.minimaxi.com/v1
SDDCTX_MINIMAX_MODEL=MiniMax-M3.1-Flash
SDDCTX_MINIMAX_MAX_TOKENS=16384
SDDCTX_MINIMAX_TEMPERATURE=0.2
