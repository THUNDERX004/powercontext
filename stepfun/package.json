{
  "name": "stepfun-browser-hybrid-kb",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-local embeddings with seekdb hybrid retrieval",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "start:win": "set NODE_ENV=production&& node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:browser": "node scripts/browser-smoke.js",
    "benchmark:quality": "node scripts/quality-benchmark.js",
    "check": "npm run test && npm run build",
    "health": "node scripts/health-check.js",
    "init-db": "node scripts/init-db.js"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "express": "5.3.0",
    "mysql2": "3.24.6",
    "seekdb": "1.4.0"
  },
  "devDependencies": {
    "playwright-core": "1.64.1",
    "vite": "8.3.5"
  }
}
